{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/fonts/*",
      "/icons/*",
      "/*.{css,js,png,jpg,avif,svg,webp,webmanifest,ico,woff2,json,txt,xml,wasm}"
    ]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.sociobot.in; manifest-src 'self'; worker-src 'self'; form-action 'self'; upgrade-insecure-requests",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".avif": "image/avif"
  },
  "routes": [
    {
      "route": "/assets/index-*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/privacy/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/terms/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/legal.css",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
